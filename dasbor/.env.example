# Salin ke .env.local lalu isi. Nilai ini ditanam saat build (Vite), jadi ubah lalu build ulang.

# Alamat backend (untuk login). Harus mengizinkan origin dasbor di CORS_ORIGIN.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Alamat service analitik. Harus mengizinkan origin dasbor di ANALITIK_CORS_ORIGIN.
VITE_ANALITIK_URL=http://127.0.0.1:8100

# Produksi (rencana): dasbor di https://financa-dash.cianjur.space
# Set VITE_BACKEND_URL dan VITE_ANALITIK_URL ke alamat HTTPS masing-masing service saat deploy.
