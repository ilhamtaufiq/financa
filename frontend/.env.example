# Salin ke .env. Dibaca saat build dan saat `npm run dev` dijalankan ulang.
# Alamat backend financa-api. Di produksi isi dengan domain API (HTTPS).
PUBLIC_API_URL=http://127.0.0.1:8000

# Alamat publik situs ini (tanpa garis miring di akhir), mis. https://financa.contoh.com.
# Dipakai untuk canonical, Open Graph, dan sitemap. Wajib diisi saat build produksi.
# Kosong = tag yang butuh alamat absolut dilewati dan sitemap kosong.
# PUBLIC_SITE_URL=https://financa.contoh.com
