# Salin ke .env lalu isi. JANGAN commit file .env.

# Database MariaDB/MySQL. Wajib. Format: mysql://user:pass@host:port/nama_db
# Karakter khusus di password harus di-percent-encode (mis. @ menjadi %40).
DATABASE_URL=mysql://financa:ganti-password@127.0.0.1:3306/financa

# Alamat tempat API mendengarkan. Default hanya localhost.
BIND=127.0.0.1:8000

# Origin frontend yang boleh memanggil API (CORS). Bisa lebih dari satu, dipisah koma.
# Harus sama persis dengan alamat di browser (termasuk port).
CORS_ORIGIN=http://localhost:4322,http://localhost:4323

# Pengiriman email (reset kata sandi dan pendaftaran).
# Format: smtps://user:pass@host:465 (TLS langsung) atau smtp://user:pass@host:587 (STARTTLS).
# Kosongkan atau hapus baris ini: email tidak terkirim dan reset kata sandi tidak berfungsi.
SMTP_URL=smtps://noreply%40contoh.com:ganti-password-smtp@smtp.contoh.com:465

# Alamat pengirim yang tampil di email.
SMTP_DARI=Financa <noreply@contoh.com>

# Halaman reset kata sandi di frontend. Token ditambahkan sebagai ?token=...
FRONTEND_RESET_URL=http://localhost:4322/reset

# Folder model OCR untuk baca struk. Default: models (relatif terhadap folder kerja).
# Unduh dua berkas ini ke folder tersebut:
#   https://ocrs-models.s3-accelerate.amazonaws.com/text-detection.rten
#   https://ocrs-models.s3-accelerate.amazonaws.com/text-recognition.rten
# Tanpa model, API tetap jalan, tetapi endpoint /transaksi/ocr menjawab 503.
# OCR_MODEL_DIR=models

# Folder berkas bukti transaksi (foto struk atau PDF, maksimal 5 MB per berkas).
# Folder ini harus bisa ditulis oleh server dan tidak boleh diakses langsung dari web.
# BUKTI_DIR=storage/bukti

# Integrasi Gmail (tangkap transaksi dari email notifikasi). Kosongkan semua untuk mematikan.
# GMAIL_ENC_KEY: 64 karakter heks (32 byte), misal hasil `openssl rand -hex 32`. Dipakai untuk mengenkripsi refresh token.
# GMAIL_REDIRECT_URI harus sama persis dengan yang didaftarkan di Google Cloud.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/gmail/callback
GMAIL_ENC_KEY=
GMAIL_FRONTEND_URL=http://localhost:4322/app/draf
