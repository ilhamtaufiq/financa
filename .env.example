# Salin ke .env untuk uji lokal (docker compose). JANGAN commit .env.
# Di Coolify, isi variabel yang sama lewat UI Environment Variables.

# Database. Wajib. Karakter khusus di password harus di-URL-encode untuk DATABASE_URL (mis. @ -> %40).
MYSQL_PASSWORD=ganti-password-db
MYSQL_ROOT_PASSWORD=ganti-password-root

# Alamat publik. PUBLIC_API_URL dan PUBLIC_SITE_URL dipakai saat BUILD frontend.
# Di Coolify centang "Build variable" untuk keduanya.
PUBLIC_API_URL=http://localhost:8000
PUBLIC_SITE_URL=

# Origin frontend yang boleh memanggil API (harus sama persis dengan URL di browser).
CORS_ORIGIN=http://localhost:8080
FRONTEND_RESET_URL=http://localhost:8080/reset

# Email (reset kata sandi). Kosongkan jika belum ada SMTP.
# Format: smtps://user:pass@host:465 atau smtp://user:pass@host:587
SMTP_URL=
SMTP_DARI=Financa <noreply@financa.local>
