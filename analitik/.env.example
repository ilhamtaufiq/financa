# Salin ke .env lalu isi. Jangan commit .env.

# Gunakan user MySQL dengan hak SELECT saja.
ANALITIK_DATABASE_URL=mysql://analitik_baca:<kata-sandi>@127.0.0.1:3306/financa

# Alamat bind service ini. Default 127.0.0.1:8100.
# ANALITIK_BIND=127.0.0.1:8100

# Email admin platform, dipisah koma. Hanya pemilik sesi aplikasi dengan email ini yang bisa membuka analitik.
ADMIN_EMAILS=
